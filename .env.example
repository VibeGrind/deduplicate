# Telegram API credentials
# Получите на https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash
PHONE=+1234567890

# Исходные каналы (через запятую)
# Для получения ID канала используйте @username_to_id_bot
SOURCE_CHANNELS=-1001234567890,-1009876543210

# Целевой канал (куда пересылать уникальные сообщения)
# Оставьте пустым для тестового режима (без пересылки)
TARGET_CHANNEL=-1001111111111

# Порог семантической схожести (0.0 - 1.0)
# 0.95 - консервативный (мало дубликатов)
# 0.85 - сбалансированный (рекомендуется)
# 0.75 - агрессивный (много дубликатов)
SIMILARITY_THRESHOLD=0.85

# Порог для LLM-верификации (для advanced_deduplicator.py)
# Сообщения с similarity между EDGE_CASE_THRESHOLD и SIMILARITY_THRESHOLD
# будут проверяться через LLM
EDGE_CASE_THRESHOLD=0.75

# Размер окна для дедупликации (последние N сообщений)
DEDUP_WINDOW_SIZE=1000

# ===== РАСШИРЕННЫЕ НАСТРОЙКИ (для advanced_deduplicator.py) =====

# Включить LLM-верификацию для пограничных случаев
USE_LLM_VERIFICATION=false

# OpenAI API Key (для LLM-верификации)
# Получите на https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Модель для embeddings (sentence-transformers)
# Мультиязычные (для русского + английского):
#   - paraphrase-multilingual-mpnet-base-v2 (точная, ~420MB)
#   - distiluse-base-multilingual-cased-v2 (быстрая, ~130MB)
# Английские:
#   - all-MiniLM-L6-v2 (быстрая, ~80MB)
#   - all-mpnet-base-v2 (точная, ~420MB)
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Использовать Qdrant для персистентности
USE_QDRANT=true

# Путь к Qdrant БД (для локального хранения)
# Оставьте пустым для in-memory режима
QDRANT_PATH=./qdrant_storage
